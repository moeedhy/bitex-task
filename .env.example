# Copy to `.env`. Docker Compose reads this file automatically, both for its own
# `${...}` substitutions below and — via `env_file` — for the application
# container. Running outside Compose (`pnpm nx serve @bitex/api`) needs the
# values exported: `set -a; source .env; set +a`.
#
# Every variable here is parsed and validated by `apps/api/src/config/app-config.ts`
# at startup. Anything not listed there is ignored; anything invalid fails the
# boot with the variable named.

# --- Host ports published by docker-compose -------------------------------
POSTGRES_PORT=55433
REDIS_PORT=63791
KAFKA_PORT=9193

# --- HTTP -----------------------------------------------------------------
PORT=3000

# --- PostgreSQL -----------------------------------------------------------
# Points at the published host port, so this file works for a local process
# talking to the Compose stack. The application container overrides it with the
# in-network address.
DATABASE_URL=postgresql://pooleno:pooleno@localhost:55433/pooleno
TEST_DATABASE_URL=postgresql://pooleno:pooleno@localhost:55433/pooleno_test
DATABASE_POOL_MAX=10
# Bounds how long a statement waits for a contended wallet row, so a duplicate
# burst cannot park pooled connections indefinitely.
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_MIGRATIONS_DIR=src/adapters/database/migrations
DATABASE_SEED_PATH=src/adapters/database/seed.sql
SEED_DEV_DATA=false

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:63791
WITHDRAWAL_RATE_LIMIT=10
WITHDRAWAL_RATE_LIMIT_WINDOW_SECONDS=60

# --- Kafka ----------------------------------------------------------------
# Off by default so the HTTP API and the test suite need no broker.
ENABLE_MESSAGING=false
KAFKA_BROKERS=localhost:9193
KAFKA_TOPIC=withdrawal-execution-requested
# Defaults to `<KAFKA_TOPIC>.dlq` when unset.
KAFKA_DLQ_TOPIC=withdrawal-execution-requested.dlq
KAFKA_CLIENT_ID=pooleno-withdrawal
KAFKA_CONSUMER_GROUP=withdrawal-executors
# Messages are keyed by withdrawalId, so one aggregate's lifecycle stays on one
# partition however many there are. More than one buys parallelism without
# weakening that ordering. The DLQ always gets one — ordering across dead
# letters means nothing. See DECISIONS.md §44.
KAFKA_TOPIC_PARTITIONS=3
# 1 suits the single-broker Compose stack; raise it to match a real cluster.
KAFKA_TOPIC_REPLICATION_FACTOR=1

# --- Outbox relay ---------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETENTION_MS=604800000
OUTBOX_PRUNE_INTERVAL_MS=3600000
OUTBOX_BATCH_SIZE=20
# How long a claimed outbox row stays leased to one replica.
OUTBOX_LEASE_SECONDS=30

# --- Consumer -------------------------------------------------------------
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_BACKOFF_MS=250

# --- Stuck-withdrawal recovery --------------------------------------------
WITHDRAWAL_PROCESSING_TIMEOUT_MS=900000
WITHDRAWAL_RECOVERY_INTERVAL_MS=60000
WITHDRAWAL_RECOVERY_BATCH_SIZE=50

# --- Fake provider --------------------------------------------------------
# SUCCESS or FAILED. Drives the whole failure path end to end without a broker.
FAKE_PROVIDER_OUTCOME=SUCCESS
